# Central web backend (web/backend) this robot reports to.
# ROBOT_API_KEY is issued once by an admin via the management website
# (Robots -> Create) and should be treated as a secret.
BACKEND_URL=http://localhost:8000
ROBOT_API_KEY=

# How often (seconds) the robot re-pulls its config and sends a heartbeat.
CONFIG_REFRESH_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=60

# Local fallback values, only used until the first successful config fetch
# from the backend (e.g. first boot with no network yet).
ALERT_COOLDOWN_SECONDS=10
RESTRICTED_HOUR_START=22
RESTRICTED_HOUR_END=6
ALWAYS_ALERT=false
PATROL_MINUTES=30
REST_MINUTES=30

# Camera frame size for detection
FRAME_WIDTH=320
FRAME_HEIGHT=240
FRAME_FPS=20

# Detection tuning
DETECTION_SCALE=1.05
MIN_DETECTIONS_TO_ALERT=1

# If true, show OpenCV preview window
DISPLAY_PREVIEW=false

