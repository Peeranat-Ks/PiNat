BOT_TOKEN=
CHAT_ID=

# Cooldown between alerts in seconds
ALERT_COOLDOWN_SECONDS=10

# Start restricted mode at this hour (24h format). Example 22 = 10 PM
RESTRICTED_HOUR_START=22

# If true, alerts can be sent at any hour
ALWAYS_ALERT=false

# Camera frame size for detection
FRAME_WIDTH=320
FRAME_HEIGHT=240
FRAME_FPS=20

# Detection tuning
DETECTION_SCALE=1.05
MIN_DETECTIONS_TO_ALERT=1

# If true, show OpenCV preview window
DISPLAY_PREVIEW=false
